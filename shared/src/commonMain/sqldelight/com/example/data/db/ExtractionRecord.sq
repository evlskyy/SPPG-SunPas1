CREATE TABLE extraction_records (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    sourceSnippet TEXT NOT NULL,
    tasksExtracted INTEGER NOT NULL,
    menusExtracted INTEGER NOT NULL,
    timestamp INTEGER NOT NULL DEFAULT 0
);

getAllExtractions:
SELECT * FROM extraction_records ORDER BY timestamp DESC;

insertExtraction:
INSERT OR REPLACE INTO extraction_records(sourceSnippet, tasksExtracted, menusExtracted, timestamp)
VALUES (?, ?, ?, ?);
